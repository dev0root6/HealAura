# Sarvam
SARVAM_API_KEY=your-sarvam-api-key

# Neon (hosted Postgres)
NEON_DATABASE_URL=postgresql://USER:PASSWORD@host.neon.tech/dbname?sslmode=require

# Alert-a-friend email (Gmail SMTP with an app password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
# SMTP_FROM_NAME=HealAura

# Speech (optional — these are the defaults)
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_STT_MODE=codemix
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=ishita
# SARVAM_TTS_LANGUAGE=en-IN

# Confidence (optional) — extra classification samples per entry used to
# estimate how sure the model is; 0 disables. Each sample is one more Sarvam call.
# CONFIDENCE_SAMPLES=2
